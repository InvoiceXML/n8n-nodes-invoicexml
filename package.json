{
	"name": "@invoicexml/n8n-nodes-invoicexml",
	"version": "0.1.1",
	"description": "n8n node for InvoiceXML: create, validate and convert EU e-invoices (XRechnung, ZUGFeRD, Factur-X, UBL / Peppol BIS, CII).",
	"license": "MIT",
	"homepage": "https://www.invoicexml.com",
	"keywords": [
		"n8n-community-node-package",
		"e-invoice",
		"xrechnung",
		"zugferd",
		"factur-x",
		"peppol",
		"ubl",
		"en16931"
	],
	"author": {
		"name": "InvoiceXML",
		"email": "support@invoicexml.com",
		"url": "https://www.invoicexml.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/InvoiceXML/n8n-nodes-invoicexml.git"
	},
	"bugs": {
		"url": "https://github.com/InvoiceXML/n8n-nodes-invoicexml/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/InvoiceXmlApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/InvoiceXml/InvoiceXml.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.56.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
